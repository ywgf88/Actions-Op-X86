#
# OpenWrt 25.12.6 官方源码 / x86-64 generic
# 由 Actions-OpenWrt 模板改写：目标从 Cetron CT3003(mediatek-filogic) 换为 x86/64
#

#
# Target
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_TARGET_DEVICE_x86_64_DEVICE_generic=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
# 镜像分区大小：默认 rootfs 仅 104MB，本配置装包约 520MB，会卡在 root.ext4 打包
CONFIG_TARGET_KERNEL_PARTSIZE=32
CONFIG_TARGET_ROOTFS_PARTSIZE=1024
# 编译缓存：ccache 让第二次起跳过重复的 C/C++ 编译（路径固定为 /workdir/openwrt/.ccache 才能命中）
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/workdir/openwrt/.ccache"

#
# Version
#
CONFIG_VERSION_NUMBER="25.12.6"

#
# LuCI 基础
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lib-jsonc=y
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_luci-nginx=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# 中文语言包
#
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn=y
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_luci-i18n-clashoo-zh-cn=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vantage-theme-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vantage-zh-cn=y
CONFIG_PACKAGE_luci-i18n-partexp-zh-cn=y

#
# 主题（默认主题在 files/etc/uci-defaults 中指定为 Argon）
#
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-theme-vantage=y
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

#
# 第三方应用
#
CONFIG_PACKAGE_luci-app-run=y
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_quickfile=y
CONFIG_PACKAGE_luci-app-partexp=y
CONFIG_PACKAGE_luci-app-diskman=y

#
# 代理
#
CONFIG_PACKAGE_luci-app-passwall2=y
CONFIG_PACKAGE_luci-app-passwall2_Nftables_Transparent_Proxy=y
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All=y
CONFIG_PACKAGE_luci-app-clashoo=y
CONFIG_PACKAGE_clashoo=y
CONFIG_PACKAGE_chinadns-ng=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

#
# Docker
#
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y

#
# 磁盘 / 分区相关依赖（partexp、diskman 用）
#
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_losetup=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_btrfs-progs=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_exfat-mkfs=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_wipefs=y
CONFIG_PACKAGE_swap-utils=y
CONFIG_PACKAGE_xfs-mkfs=y
CONFIG_PACKAGE_smartmontools=y
CONFIG_PACKAGE_kmod-loop=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-xfs=y

#
# 默认 IPv4：不装 DHCPv6/RA 组件（内核 IPv6 仍保留，避免影响 nftables）
#
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_ipv6helper is not set

#
# 其它常用
#
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y

#
# 家庭 / 运维工具（补充）
#
# SQM 流量整形
CONFIG_PACKAGE_luci-app-sqm=y
# 动态域名
CONFIG_PACKAGE_luci-app-ddns=y
# 网络唤醒
CONFIG_PACKAGE_luci-app-wol=y
# 流量统计
CONFIG_PACKAGE_luci-app-nlbwmon=y
# WireGuard 协议
CONFIG_PACKAGE_luci-proto-wireguard=y
# UPnP 端口映射
CONFIG_PACKAGE_luci-app-upnp=y
# 命令面板
CONFIG_PACKAGE_luci-app-commands=y

# 中文语言包
CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y
CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y
CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y
